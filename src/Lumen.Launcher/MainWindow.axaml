<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumen.Launcher"
        x:Class="Lumen.Launcher.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Lumen"
        Width="720"
        Height="640"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Panel>
    <Border Background="{StaticResource Bg}" IsVisible="{Binding !IsLoggedIn}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340" Spacing="14">
        <TextBlock Text="Lumen" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding AuthTitle}" FontSize="18" HorizontalAlignment="Center" Foreground="#FFB3D9"/>
        <TextBlock Text="Solo usuario y contraseña." Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
        <TextBox Watermark="usuario" Text="{Binding LoginUser}" FontSize="16"/>
        <TextBox Watermark="contraseña" Text="{Binding LoginPassword}" PasswordChar="•" FontSize="16"/>
        <TextBox Watermark="repite la contraseña" Text="{Binding LoginPasswordConfirm}" PasswordChar="•" FontSize="16"
                 IsVisible="{Binding AuthIsCreate}"/>
        <Button Classes="pink" Content="{Binding AuthButton}" Click="OnSubmitAuth" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <Button Classes="ghost" Content="{Binding AuthSwitch}" Click="OnToggleAuth" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <TextBlock Text="{Binding Status}" Foreground="#FFB3D9" TextWrapping="Wrap" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <DockPanel IsVisible="{Binding IsLoggedIn}">
      <Grid DockPanel.Dock="Top" Margin="24,20,24,8" ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Lumen" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Greeting}" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="ghost" Content="Cambiar nombre" Click="OnLogout" VerticalAlignment="Center"/>
      </Grid>

      <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="24,8,24,16" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>

      <ScrollViewer Padding="24,8,24,8">
        <StackPanel Spacing="16">
          <TextBlock Text="1. En este PC pulsa Compartir.&#x0a;2. En el otro PC pulsa Conectar."
                     TextWrapping="Wrap" FontSize="16"/>

          <Button Classes="pink" Content="{Binding ShareLabel}" Click="OnShare"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  FontSize="18" Padding="20,14"
                  IsEnabled="{Binding !IsInstalling}"/>

          <Border IsVisible="{Binding IsSharing}" Background="{StaticResource Card}" CornerRadius="14" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="Este PC ya es el stream" FontWeight="SemiBold" Foreground="#3DFF9A" FontSize="18"/>
              <TextBlock Text="{Binding ShareHelp}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
              <TextBlock Text="{Binding ShareCode}" FontSize="28" FontWeight="Bold"/>
              <TextBlock Text="El PIN sale en Moonlight en el OTRO PC. Escríbelo aquí (4 números) o pulsa Listo." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="160" Watermark="PIN" Text="{Binding Pin}" FontSize="18"/>
                <Button Classes="purple" Content="Listo" Click="OnPair"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding ShowTailscaleHelp}" Background="#2A1430" CornerRadius="14" Padding="16" BorderBrush="#FF4DA6" BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock Text="Desde otra casa no va a entrar (todavía)" FontWeight="SemiBold" Foreground="#FFB3D9" FontSize="18"/>
              <TextBlock Text="Tu internet tiene doble NAT: el código público no cruza. La salida sin instalar nada es el relay Lumen. Pega aquí tu relay (host:puerto:secreto) y comparte otra vez — el código cambia a relay:… y ya cruza casas." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
              <TextBox Watermark="relay Lumen (host:puerto:secreto)" Text="{Binding RelayServer}" HorizontalAlignment="Stretch"/>
              <TextBlock Text="¿No tienes un relay? Es gratis: una VM en Oracle Cloud (10 min, una vez). Pídelo y te guío paso a paso." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13"/>
              <Border CornerRadius="8" Padding="8,2" Background="#3A255C" HorizontalAlignment="Left">
                <TextBlock Text="o, como alternativa, instala Tailscale en las dos PCs (misma cuenta):" FontSize="13" Foreground="{StaticResource Muted}"/>
              </Border>
              <Button Classes="pink" Content="{Binding TailscaleButtonLabel}" Click="OnInstallTailscale"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      IsEnabled="{Binding !TailscaleBusy}"/>
            </StackPanel>
          </Border>

          <TextBlock Text="Otros PCs" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>

          <ItemsControl ItemsSource="{Binding Computers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComputerItem">
                <Border Background="{StaticResource Card}" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
                        <Border CornerRadius="8" Padding="8,2" Background="#3A255C">
                          <TextBlock Text="{Binding Badge}" FontSize="12"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="pink" Content="Conectar" Tag="{Binding}" Click="OnConnectCard"
                            IsVisible="{Binding ShowConnect}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="¿No aparece el otro PC?" FontWeight="SemiBold"/>
          <TextBlock Text="Pega el código y pulsa Conectar. Si estás en otra casa y el código es 192.168.x, no va: hace falta IPv6, el relay Lumen o Tailscale." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" Watermark="código o IP" Text="{Binding RemoteAddress}"/>
            <Button Classes="purple" Content="Añadir" Click="OnAddRemote"/>
            <Button Classes="pink" Content="Conectar" Click="OnConnectTyped"/>
          </StackPanel>

          <Border Background="{StaticResource Card}" CornerRadius="14" Padding="16" Margin="0,8,0,0">
            <StackPanel Spacing="10">
              <Button Classes="ghost" Content="{Binding AdvancedLabel}" Click="OnToggleAdvanced"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      FontSize="16" FontWeight="SemiBold"/>
              <Panel IsVisible="{Binding ShowAdvanced}">
                <StackPanel Spacing="8">
                  <TextBlock Text="Relay Lumen (para cruzar CGNAT sin instalar nada). Formato: host:puerto:secreto. Vacío = no usar relay. Ej.: relay.midominio.com:47991:secreto" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                  <TextBox Watermark="relay Lumen (host:puerto:secreto)" Text="{Binding RelayServer}" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Panel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Panel>
</Window>
